{
  "manifest_version": 3,
  "name": "ThreatGuard - Simple Enhanced",
  "version": "2.0.2",
  "description": "Simple enhanced version with threat history, risk indicator, and content scanner",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background-simple-v2.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-simple-v2.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup-simple.html",
    "default_title": "ThreatGuard Simple Enhanced",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["warning.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

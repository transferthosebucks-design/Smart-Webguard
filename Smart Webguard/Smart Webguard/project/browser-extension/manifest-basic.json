{
  "manifest_version": 3,
  "name": "ThreatGuard - Basic Working",
  "version": "1.0.0",
  "description": "Simple working version - guaranteed to work",
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background-basic.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-basic.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ThreatGuard Basic"
  }
}
